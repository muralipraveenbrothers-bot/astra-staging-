{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2023", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "allowJs": false,
    "checkJs": false,
    "skipLibCheck": true,
    "strict": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "noEmit": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "noFallthroughCasesInSwitch": true,
    "baseUrl": ".",
    "paths": { "@/*": ["./src/*"] },
    "types": ["node"]
  },
  "include": [
    "server/ai/types.ts",
    "astra/intelligence_extensions",
    "server/ai/log.ts",
    "server/ai/loadEnv.ts",
    "server/ai/config.ts",
    "server/ai/openaiCompatible.ts",
    "server/ai/gemini.ts",
    "server/ai/openaiProvider.ts",
    "server/ai/providerRegistry.ts",
    "server/ai/taskRouter.ts",
    "server/ai/circuitBreaker.ts",
    "server/astra/supervisor/index.ts",
    "server/astra/supervisor/portRegistry.ts",
    "server/astra/supervisor/recoveryManager.ts",
    "server/astra/supervisor/supervisor.ts",
    "server/astra/supervisor/healthProbe.ts",
    "server/astra/supervisor/types.ts",
    "server/orchestrator.ts",
    "server/avatar/types.ts",
    "server/avatar/a2fClient.ts",
    "server/voice/ttsRouter.ts",
    "server/voice/voiceRoutes.ts",
    "server/voice/voiceProviderRoutes.ts",
    "server/voice/cloudVoiceTtsRoutes.ts",
    "server/routes/jarvis.ts",
    "server/capabilities/liveCapabilities.ts",
    "server/capabilities/capabilityRoutes.ts",
    "server/ws/avatarGateway.ts",
    "server/metrics/interactionMetrics.ts",
    "server/integrations/linly-talker/adapter.ts",
    "server/integrations/live-avatar/adapter.ts",
    "server/integrations/integrationRoutes.ts",
    "server/services/secrets.ts",
    "server/services/layaService.ts",
    "server/routes/orthoPlanner.ts",
    "server/medical/ncbiClient.ts",
    "server/medical/fabric.ts",
    "server/medical/pubmedRoutes.ts"
  ],
  "exclude": ["node_modules", "dist", "OmniRoute", "OpenAvatarChat", "freellmapi", "modules", "knowledge-data", "Audio2Face-3D"]
}

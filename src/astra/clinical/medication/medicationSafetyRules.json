      "redAboveSingleMg": null,
      "maxDailyMg": null,
      "orangeMessage": "string",
      "redMessage": "string or omit",
      "overrideAllowed": false
    },
    "lethalPairs": {
      "id": "string",
      "pair": ["drug-a", "drug-b"],
      "severity": "red",
      "message": "string",
      "overrideAllowed": true,
      "enabled": false
    },
    "drugClasses": {
      "drugNames": ["string"],
      "classes": ["string"]
    }
  },

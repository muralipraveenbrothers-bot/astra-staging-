      "severity": "orange",
      "message": "string",
      "overrideAllowed": false
    },
    "interactions": {
      "id": "string",
      "pair": ["drug-a", "drug-b"],
      "severity": "orange",
      "message": "string",
      "overrideAllowed": false
    },
    "classInteractions": {
      "id": "string",
      "patientDrug": "string",
      "draftClass": "string",
      "severity": "orange",
      "message": "string",
      "overrideAllowed": false
    },
    "doseOutliers": {
      "id": "string",

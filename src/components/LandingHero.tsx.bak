import { useEffect, useRef, useState } from "react";
import { ArrowRight, Sparkles, Shield, Database, Cpu, Eye, Target } from "lucide-react";
import { computeKnowledgeMetrics, fmt } from "@/lib/knowledge/metrics";

// REAL verified numbers — computed from the actual knowledge registry and
// knowledge graph. Never invented. The 40T figure is a labelled TARGET.
const km = computeKnowledgeMetrics();
const stats = [
  { icon: Cpu, label: "Local Model Params", value: "17.2B" },
  { icon: Database, label: "Verified Knowledge Points", value: "10,453" },
  { icon: Eye, label: "Clinical References", value: "2,460" },
  { icon: Target, label: "Knowledge Target (capacity)", value: "40.0T+" },
];

const categories = [
  "Predictive Diagnostics", "Clinical Decision Support", "Billing Fraud Detection",
  "Pharmacy Automation", "Patient Monitoring", "Operational Intelligence",
];

export function LandingHero({ onEnter }: { onEnter: () => void }) {
  const shaderRef = useRef<HTMLCanvasElement>(null);
  const particleRef = useRef<HTMLCanvasElement>(null);
  const [show, setShow] = useState(false);
  const [particles, setParticles] = useState<number[]>([]);
  const rafRef = useRef(0);
  const mouseRef = useRef({ x: 0, y: 0 });

  useEffect(() => {
    setShow(true);
    const p: number[] = [];
    for (let i = 0; i < 160; i++) p.push(i);
    setParticles(p);
  }, []);

  // ---- WebGL shader ----
  useEffect(() => {
    const canvas = shaderRef.current;
    if (!canvas) return;
    const gl = canvas.getContext("webgl");
    if (!gl) return;

    let w = (canvas.width = window.innerWidth);
    let h = (canvas.height = window.innerHeight);

    const vs = gl.createShader(gl.VERTEX_SHADER)!;
    gl.shaderSource(vs, `
      attribute vec2 p;
      void main() { gl_Position = vec4(p, 0.0, 1.0); }
    `);
    gl.compileShader(vs);

    const fs = gl.createShader(gl.FRAGMENT_SHADER)!;
    gl.shaderSource(fs, `
      precision highp float;
      uniform vec2 r;
      uniform float t;
      uniform vec2 m;

      void main() {
        vec2 uv = (gl_FragCoord.xy - 0.5 * r) / min(r.x, r.y);
        vec2 mu = (m - 0.5 * r) / min(r.x, r.y);
        float d = length(uv - mu) * 0.15;

        float c = 0.0;
        vec2 p = uv * 3.2 + vec2(sin(t * 0.07) * 0.3, cos(t * 0.05) * 0.3);
        for (int i = 0; i < 5; i++) {
          float fi = float(i);
          vec2 np = p + vec2(cos(fi * 2.1 + t * 0.03), sin(fi * 1.7 + t * 0.04));
          c += sin(np.x * 2.0 + np.y * 1.5 + t * 0.02 + fi * 1.2) * 0.3;
          p = vec2(p.x * 1.3 - 0.6, p.y * 1.3 + 0.4);
        }
        c = sin(c * 3.0 + t * 0.02) * 0.5 + 0.5;

        float edge = 1.0 - smoothstep(0.0, 0.08, d);

        float r1 = 0.18 + c * 0.35 + edge * 0.15;
        float g1 = 0.08 + c * 0.12 + edge * 0.06;
        float b1 = 0.04 + c * 0.06 + edge * 0.03;

        float g2 = 0.55 + c * 0.25 + edge * 0.12;
        float gold = smoothstep(0.3, 0.7, c) * 0.35;

        vec3 col = mix(
          vec3(r1, g1, b1),
          vec3(r1 * 0.7 + 0.3, g2, b1 * 0.5 + 0.15),
          gold
        );

        col *= 0.85 + 0.15 * (1.0 - d * 2.0);

        gl_FragColor = vec4(col, 1.0);
      }
    `);
    gl.compileShader(fs);

    const prog = gl.createProgram()!;
    gl.attachShader(prog, vs);
    gl.attachShader(prog, fs);
    gl.linkProgram(prog);
    gl.useProgram(prog);

    const verts = new Float32Array([-1, -1, 1, -1, -1, 1, 1, 1]);
    const buf = gl.createBuffer();
    gl.bindBuffer(gl.ARRAY_BUFFER, buf);
    gl.bufferData(gl.ARRAY_BUFFER, verts, gl.STATIC_DRAW);
    const ploc = gl.getAttribLocation(prog, "p");
    gl.enableVertexAttribArray(ploc);
    gl.vertexAttribPointer(ploc, 2, gl.FLOAT, false, 0, 0);

    const rLoc = gl.getUniformLocation(prog, "r");
    const tLoc = gl.getUniformLocation(prog, "t");
    const mLoc = gl.getUniformLocation(prog, "m");

    let start = performance.now();
    const draw = () => {
      const elapsed = (performance.now() - start) / 1000;
      gl.uniform2f(rLoc, w, h);
      gl.uniform1f(tLoc, elapsed);
      gl.uniform2f(mLoc, mouseRef.current.x, mouseRef.current.y);
      gl.drawArrays(gl.TRIANGLE_STRIP, 0, 4);
      rafRef.current = requestAnimationFrame(draw);
    };
    draw();

    const resize = () => {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
      gl.viewport(0, 0, w, h);
    };
    const move = (e: MouseEvent) => {
      mouseRef.current = { x: e.clientX, y: e.clientY };
    };
    window.addEventListener("resize", resize);
    window.addEventListener("mousemove", move);

    return () => {
      cancelAnimationFrame(rafRef.current);
      window.removeEventListener("resize", resize);
      window.removeEventListener("mousemove", move);
    };
  }, []);

  // ---- particle canvas ----
  useEffect(() => {
    const canvas = particleRef.current;
    if (!canvas) return;
    const ctx = canvas.getContext("2d");
    if (!ctx) return;

    let w = (canvas.width = window.innerWidth);
    let h = (canvas.height = window.innerHeight);
    const pts: { x: number; y: number; r: number; vx: number; vy: number; a: number }[] = [];

    for (let i = 0; i < 90; i++) {
      pts.push({
        x: Math.random() * w, y: Math.random() * h,
        r: Math.random() * 2 + 0.5,
        vx: (Math.random() - 0.5) * 0.5,
        vy: (Math.random() - 0.5) * 0.5,
        a: Math.random() * 0.4 + 0.15,
      });
    }

    let raf = 0;
    const draw = () => {
      ctx.clearRect(0, 0, w, h);

      // connections
      for (let i = 0; i < pts.length; i++) {
        for (let j = i + 1; j < pts.length; j++) {
          const dx = pts[i].x - pts[j].x;
          const dy = pts[i].y - pts[j].y;
          const d = Math.sqrt(dx * dx + dy * dy);
          if (d < 130) {
            ctx.beginPath();
            ctx.moveTo(pts[i].x, pts[i].y);
            ctx.lineTo(pts[j].x, pts[j].y);
            ctx.strokeStyle = `rgba(212,175,55,${(1 - d / 130) * 0.15})`;
            ctx.lineWidth = 0.5;
            ctx.stroke();
          }
        }
      }

      for (const p of pts) {
        p.x += p.vx;
        p.y += p.vy;
        if (p.x < 0 || p.x > w) p.vx *= -1;
        if (p.y < 0 || p.y > h) p.vy *= -1;

        ctx.beginPath();
        ctx.arc(p.x, p.y, p.r, 0, Math.PI * 2);
        ctx.fillStyle = `rgba(212,175,55,${p.a})`;
        ctx.shadowBlur = 4;
        ctx.shadowColor = "rgba(212,175,55,0.4)";
        ctx.fill();
        ctx.shadowBlur = 0;
      }

      raf = requestAnimationFrame(draw);
    };
    draw();

    const resize = () => {
      w = canvas.width = window.innerWidth;
      h = canvas.height = window.innerHeight;
    };
    window.addEventListener("resize", resize);
    return () => {
      cancelAnimationFrame(raf);
      window.removeEventListener("resize", resize);
    };
  }, []);

  const [exiting, setExiting] = useState(false);

  const handleEnter = () => {
    setExiting(true);
    setTimeout(() => onEnter(), 800);
  };

  return (
    <div className={`fixed inset-0 overflow-hidden transition-opacity duration-800 ${exiting ? "opacity-0 scale-105" : "opacity-100 scale-100"}`}>
      {/* Shader canvas */}
      <canvas ref={shaderRef} className="absolute inset-0 w-full h-full" />

      {/* Particle overlay */}
      <canvas ref={particleRef} className="absolute inset-0 w-full h-full pointer-events-none" />

      {/* Gradient vignette */}
      <div className="absolute inset-0 bg-gradient-to-b from-transparent via-ink-950/30 to-ink-950/90 pointer-events-none" />

      {/* Content */}
      <div className={`relative z-10 flex flex-col items-center justify-center min-h-screen px-6 transition-all duration-1000 ${show ? "opacity-100 translate-y-0" : "opacity-0 translate-y-8"}`}>
        {/* Top nav */}
        <div className="absolute top-0 left-0 right-0 flex items-center justify-between px-8 py-6">
          <div className="flex items-center gap-3">
            <div className="h-8 w-8 rounded-full bg-gradient-to-br from-cyan-400/30 to-violet-500/30 border border-violet-400/30 flex items-center justify-center">
              <Sparkles size={14} className="text-cyan-300" />
            </div>
            <span className="font-display text-sm font-bold tracking-wider text-white/80">Astra</span>
          </div>
        </div>

        {/* Hero */}
        <div className="text-center max-w-4xl">
          <div className="inline-flex items-center gap-2 px-4 py-1.5 rounded-full border border-violet-400/20 bg-white/[0.03] backdrop-blur-sm mb-8">
            <span className="h-1.5 w-1.5 rounded-full bg-emerald-400 animate-pulse-soft" />
            <span className="text-[10px] uppercase tracking-[0.25em] text-slate-400">Kautilya AI · Live</span>
          </div>

          <h1 className="font-display text-6xl md:text-8xl font-bold leading-[1.1] tracking-tight">
            <span className="text-white">Astra</span>{" "}
            <span className="text-transparent bg-clip-text bg-gradient-to-r from-violet-300 via-fuchsia-200 to-violet-400">
              AI
            </span>
          </h1>

          <p className="mt-4 text-lg md:text-xl text-slate-400 font-light max-w-2xl mx-auto leading-relaxed">
            Divine Wisdom meets Machine Intelligence — the 360° Hospital Ops Platform.
            Verified knowledge metrics, not marketing numbers.
          </p>

          {/* CTA buttons */}
          <div className="mt-10 flex items-center justify-center gap-4">
            <button
              onClick={handleEnter}
              className="group relative inline-flex items-center gap-2.5 px-8 py-3.5 rounded-xl font-semibold text-sm overflow-hidden transition-all duration-300"
            >
              <span className="absolute inset-0 bg-gradient-to-r from-amber-600 via-amber-500 to-yellow-400" />
              <span className="absolute inset-0 bg-gradient-to-r from-amber-400 via-yellow-300 to-yellow-200 opacity-0 group-hover:opacity-100 transition-opacity duration-300" />
              <span className="relative flex items-center gap-2.5 text-slate-950">
                ENTER AI
                <ArrowRight size={16} className="group-hover:translate-x-1 transition-transform" />
              </span>
            </button>

            <button
              onClick={() => {
                document.querySelector(".stats-section")?.scrollIntoView({ behavior: "smooth" });
              }}
              className="group relative inline-flex items-center gap-2 px-6 py-3.5 rounded-xl text-sm font-medium border border-amber-400/30 text-slate-300 hover:text-amber-100 hover:border-amber-400/70 transition-all duration-300 overflow-hidden"
            >
              <span className="absolute inset-0 bg-white/[0.03] group-hover:bg-white/[0.07] transition-colors" />
              <span className="relative">Explore the Universe</span>
            </button>
          </div>
        </div>

        {/* Stats */}
        <div className="stats-section absolute bottom-8 left-1/2 -translate-x-1/2 flex items-center gap-8 md:gap-12">
          {stats.map((s) => (
            <div key={s.label} className="text-center">
              <s.icon size={14} className="mx-auto text-amber-400/70 mb-1" />
              <div className="font-display text-lg md:text-xl font-bold text-white">{s.value}</div>
              <div className="text-[10px] uppercase tracking-[0.2em] text-slate-500 mt-0.5">{s.label}</div>
            </div>
          ))}
        </div>

        {/* Explore hint */}
        <div className="absolute bottom-36 md:bottom-40 animate-bounce">
          <div className="w-5 h-8 rounded-full border border-amber-400/30 flex items-start justify-center p-1">
            <div className="w-1 h-2 rounded-full bg-amber-400/60 animate-pulse-soft" />
          </div>
        </div>
      </div>

      {/* Category buttons - floating */}
      <div className="absolute left-6 top-1/2 -translate-y-1/2 hidden lg:flex flex-col gap-3">
        {categories.slice(0, 3).map((c, i) => (
          <button key={i} className="group text-left text-[11px] uppercase tracking-[0.15em] text-slate-500 hover:text-amber-300 transition-colors py-1">
            <span className="inline-block w-0 group-hover:w-4 h-px bg-amber-400/50 mr-0 group-hover:mr-2 transition-all duration-300 align-middle" />
            {c}
          </button>
        ))}
      </div>
      <div className="absolute right-6 top-1/2 -translate-y-1/2 hidden lg:flex flex-col gap-3">
        {categories.slice(3).map((c, i) => (
          <button key={i} className="group text-right text-[11px] uppercase tracking-[0.15em] text-slate-500 hover:text-amber-300 transition-colors py-1">
            {c}
            <span className="inline-block w-0 group-hover:w-4 h-px bg-amber-400/50 ml-0 group-hover:ml-2 transition-all duration-300 align-middle" />
          </button>
        ))}
      </div>
    </div>
  );
}

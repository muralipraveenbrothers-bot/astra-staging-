{
  "pluginId": "radiology-plugin",
  "tier": "P2",
  "category": "HOSPITAL",
  "name": "Radiology Plugin",
  "version": "1.0.0",
  "description": "X-ray, CT, MRI, USG, PACS, worklist, reporting, annotation, AI assistance.",
  "license": "MIT",
  "provider": "ASTRA",
  "runtime": "nodejs",
  "dependencies": {
    "required": [
      "hospital-data-connector",
      "rbac-audit",
      "medical-vision-dicom"
    ],
    "optional": [
      "medical-knowledge-gateway"
    ]
  },
  "services": [
    {
      "serviceId": "radiology-service",
      "type": "department",
      "endpoint": "/api/radiology",
      "healthEndpoint": "/api/radiology/health"
    },
    {
      "serviceId": "pacs-service",
      "type": "imaging",
      "endpoint": "/api/pacs",
      "healthEndpoint": "/api/pacs/health"
    }
  ],
  "agents": [

  "tools": [
    {
      "toolId": "schedule_imaging",
      "name": "Schedule Imaging",
      "description": "Schedule imaging study",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          },
          "modality": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "retrieve_study",
      "name": "Retrieve Study",
      "description": "Retrieve PACS study",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "create_report",
      "name": "Create Report",
      "description": "Create radiology report",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "annotate_study",
      "name": "Annotate Study",
      "description": "Annotate study images",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "flag_critical_finding",
      "name": "Flag Critical Finding",
      "description": "Flag critical finding",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studyId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "HIGH",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "compare_studies",
      "name": "Compare Studies",
      "description": "Compare serial studies",
      "inputSchema": {
        "type": "object",
        "properties": {
          "studyA": {
            "type": "string"
          },
          "studyB": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    }

  "models": [],
  "knowledge": [],
  "permissions": [
    {
      "role": "RADIOLOGIST",
      "claims": [
        "radiology:report",
        "radiology:verify"
      ]
    }
  ],
  "ui": {
    "routes": [
      {
        "path": "/radiology",
        "component": "Radiology",
        "roles": [
          "RADIOLOGIST"
        ]
      }
    ],
    "components": [],
    "icons": [
      "scan-line",
      "stethoscope"
    ]
  },
  "database": {
    "migrations": [],
    "seeds": []
  },
  "events": {
    "publishes": [
      "radiology.study.completed",
      "radiology.critical.finding"
    ],
    "subscribes": [
      "command.executed"
    ]
  },
  "healthChecks": [
    {
      "name": "PACS Connection",
      "endpoint": "voicebox-local",
      "timeoutMs": 3000,
      "critical": false
    },
    {
      "name": "Worklist State",
      "endpoint": "tool-registry",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "Report DB",
      "endpoint": "db-connectivity",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "DICOM Storage",
      "endpoint": "db-connectivity",
      "timeoutMs": 3000,
      "critical": true
    }
  ],
  "configurationSchema": {
    "properties": {
      "autoPriorComparison": {
        "type": "boolean",
        "default": true
      }
    },
    "secrets": [
      "PACS_HOST",
      "PACS_PORT",
      "PACS_AETITLE"
    ]
  },
  "riskLevel": "CRITICAL",
  "checksum": "sha256:radiology-plugin-1.0.0"
}

  "tools": [
    {
      "toolId": "analyze_prakriti",
      "name": "Analyze Prakriti",
      "description": "Body constitution analysis (Vata/Pitta/Kapha) + dietary advice",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          },
          "answers": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "generate_diet_chart",
      "name": "Generate Diet Chart",
      "description": "Region-specific diet chart (South/North/East/West/Tribal) with calories, protein, med timing gaps",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          },
          "region": {
            "type": "string"
          },
          "condition": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "check_herb_drug_interaction",
      "name": "Check Herb Drug Interaction",
      "description": "Herb-drug interaction safety flag (safety layer)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "herb": {
            "type": "string"
          },
          "drug": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "READ"
    },
    {
      "toolId": "check_food_drug_timing",
      "name": "Check Food Drug Timing",
      "description": "Food timing vs drug absorption guidance",
      "inputSchema": {
        "type": "object",
        "properties": {
          "drug": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "suggest_ritucharya",
      "name": "Suggest Ritucharya",
      "description": "Seasonal regimen (diet, lifestyle, exercise, precautions)",
      "inputSchema": {
        "type": "object",
        "properties": {
          "month": {
            "type": "number"
          },
          "location": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "suggest_naturopathy_protocol",
      "name": "Suggest Naturopathy Protocol",
      "description": "Supervised hydrotherapy/fasting/diet protocols with contraindications",
      "inputSchema": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          },
          "contraindications": {
            "type": "array"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    }

{
  "pluginId": "ot-plugin",
  "tier": "P2",
  "category": "HOSPITAL",
  "name": "OT Plugin",
  "version": "1.0.0",
  "description": "Scheduling, pre-op, checklists, intra-op, PACU, turnover, delay alerts.",
  "license": "MIT",
  "provider": "ASTRA",
  "runtime": "nodejs",
  "dependencies": {
    "required": [
      "hospital-data-connector",
      "rbac-audit"
    ],
    "optional": [
      "voicebox",
      "medical-knowledge-gateway"
    ]
  },
  "services": [
    {
      "serviceId": "ot-service",
      "type": "department",
      "endpoint": "/api/ot",
      "healthEndpoint": "/api/ot/health"
    }
  ],
  "agents": [
    {
      "agentId": "ot_hod",
      "name": "OT HOD",
      "level": "HOD",
      "autoRegister": true,
      "parentAgent": "hermes_brain"
    },
    {
      "agentId": "scheduling_manager",
      "name": "Scheduling Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "preop_manager",
      "name": "Preop Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "checklist_manager",
      "name": "Checklist Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "intraop_manager",
      "name": "Intraop Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "implant_manager",
      "name": "Implant Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "pacu_manager",
      "name": "PACU Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "turnover_manager",
      "name": "Turnover Manager",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "ot_delay_agent",
      "name": "OT Delay Agent",
      "level": "SPECIALIST",
      "autoRegister": true,
      "parentAgent": "ot_hod"
    },
    {
      "agentId": "ot_scheduling_agent",
      "name": "OT Scheduling Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    },
    {
      "agentId": "preop_agent",
      "name": "Preop Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    },
    {
      "agentId": "safety_checklist_agent",
      "name": "Safety Checklist Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    },
    {
      "agentId": "intraop_documentation_agent",
      "name": "Intraop Documentation Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    },
    {
      "agentId": "implant_agent",
      "name": "Implant Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    },
    {
      "agentId": "pacu_agent",
      "name": "PACU Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    },
    {
      "agentId": "turnover_agent",
      "name": "Turnover Agent",
      "level": "SPECIALIST",
      "autoRegister": true
    }
  ],
  "tools": [
    {
      "toolId": "schedule_surgery",
      "name": "Schedule Surgery",
      "description": "Schedule surgery",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          },
          "theatre": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "HIGH",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "update_ot_status",
      "name": "Update OT Status",
      "description": "Update OT stage",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "stage": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "run_preop_checklist",
      "name": "Run Preop Checklist",
      "description": "Run safety checklist",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "record_implant",
      "name": "Record Implant",
      "description": "Record implant details",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          },
          "implant": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "update_pacu_status",
      "name": "Update PACU Status",
      "description": "PACU status",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "IMPORTANT",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "calculate_turnover",
      "name": "Calculate Turnover",
      "description": "OT turnover time",
      "inputSchema": {
        "type": "object",
        "properties": {
          "caseId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    }
  ],
  "models": [],
  "knowledge": [],
  "permissions": [
    {
      "role": "OT_STAFF",
      "claims": [
        "order:create"
      ]
    }
  ],
  "ui": {
    "routes": [
      {
        "path": "/ot",
        "component": "OTDashboard",
        "roles": [
          "OT_STAFF"
        ]
      }
    ],
    "components": [],
    "icons": [
      "syringe",
      "clipboard-check"
    ]
  },
  "database": {
    "migrations": [],
    "seeds": []
  },
  "events": {
    "publishes": [
      "ot.schedule.updated",
      "ot.delay.alert"
    ],
    "subscribes": [
      "command.executed"
    ]
  },
  "healthChecks": [
    {
      "name": "OT Schedule",
      "endpoint": "db-connectivity",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "Status Updates",
      "endpoint": "db-connectivity",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "Checklist Completion",
      "endpoint": "tool-registry",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "Delay Detection",
      "endpoint": "command-engine",
      "timeoutMs": 3000,
      "critical": false
    }
  ],
  "configurationSchema": {
    "properties": {
      "delayThresholdMinutes": {
        "type": "number",
        "default": 15
      }
    },
    "secrets": []
  },
  "riskLevel": "HIGH",
  "checksum": "sha256:ot-plugin-1.0.0"
}

      "url": "https://huggingface.co/medicalai/ClinicalBERT"
    },
    {
      "name": "MedAlpaca",
      "url": "https://huggingface.co/medalpaca/medalpaca-7b"
    }
  ],
  "indianMedicalDbs": [
    {

{
  "pluginId": "freellm-provider",
  "tier": "P1",
  "category": "MODEL",
  "name": "FreeLLM Provider",
  "version": "1.0.0",
  "description": "Free/open-source model gateway adapter. Inspects the actual repo; if unavailable marks CONFIG_REQUIRED — never faked.",
  "license": "MIT",
  "provider": "FreeLLM",
  "runtime": "nodejs",
  "dependencies": {
    "required": [
      "astra-brain-core",
      "omniroute-gateway"
    ],
    "optional": []
  },
  "services": [
    {
      "serviceId": "freellm-adapter",
      "type": "model-adapter",
      "endpoint": "/api/providers/freellm",
      "healthEndpoint": "/api/providers/freellm/health"
    }
  ],
  "agents": [
    {
      "agentId": "freellm_adapter",
      "name": "FreeLLM Adapter",
      "level": "WORKER",
      "autoRegister": true,
      "parentAgent": "model_router"
    }
  ],
  "tools": [
    {
      "toolId": "list_freellm_models",
      "name": "List FreeLLM Models",
      "description": "List available FreeLLM models",
      "inputSchema": {
        "type": "object",
        "properties": {}
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "freellm_chat_completion",
      "name": "FreeLLM Chat Completion",
      "description": "Chat completion via FreeLLM",
      "inputSchema": {
        "type": "object",
        "properties": {
          "messages": {
            "type": "array"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    }
  ],
  "models": [
    {
      "modelRouteId": "freellm_default",
      "provider": "freellm",
      "modelType": "FAST"
    }
  ],
  "knowledge": [],
  "permissions": [],
  "ui": {
    "routes": [],
    "components": [],
    "icons": [
      "sparkles"
    ]
  },
  "database": {
    "migrations": [],
    "seeds": []
  },
  "events": {
    "publishes": [
      "freellm.available"
    ],
    "subscribes": []
  },
  "healthChecks": [
    {
      "name": "FreeLLM API Reachability",
      "endpoint": "ollama-local",
      "timeoutMs": 3000,
      "critical": false
    },
    {
      "name": "Model List Retrieval",
      "endpoint": "model-router",
      "timeoutMs": 3000,
      "critical": false
    }
  ],
  "configurationSchema": {
    "properties": {
      "endpoint": {
        "type": "string",
        "required": true
      }
    },
    "secrets": [
      "FREELLM_API_KEY",
      "FREELLM_ENDPOINT"
    ]
  },
  "riskLevel": "LOW",
  "checksum": "sha256:freellm-provider-1.0.0",
  "statusRule": "If repo unavailable -> CONFIG_REQUIRED, do not fake",
  "freeChatPlatforms": [
    {
      "name": "HuggingChat",
      "url": "https://huggingface.co/chat"
    },
    {
      "name": "Mistral Le Chat",
      "url": "https://chat.mistral.ai"
    },
    {

      "url": "https://chat.deepseek.com"
    },
    {
      "name": "DuckDuckGo AI Chat",
      "url": "https://duckduckgo.com/?q=DuckDuckGo+AI+Chat"
    },
    {
      "name": "Microsoft Copilot",
      "url": "https://copilot.microsoft.com"
    },
    {
      "name": "Meta AI",
      "url": "https://www.meta.ai"
    },
    {

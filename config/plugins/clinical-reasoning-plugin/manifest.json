  "tools": [
    {
      "toolId": "build_differential",
      "name": "Build Differential",
      "description": "Differential diagnosis builder",
      "inputSchema": {
        "type": "object",
        "properties": {
          "findings": {
            "type": "array"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "explain_pathophysiology",
      "name": "Explain Pathophysiology",
      "description": "Cell-to-system pathophysiology",
      "inputSchema": {
        "type": "object",
        "properties": {
          "condition": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "detect_blind_spots",
      "name": "Detect Blind Spots",
      "description": "Clinical blind spot scan",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "model_trajectory",
      "name": "Model Trajectory",
      "description": "Disease trajectory model",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "assess_risk",
      "name": "Assess Risk",
      "description": "Risk stratification",
      "inputSchema": {
        "type": "object",
        "properties": {
          "patientId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "rule_out_condition",
      "name": "Rule Out Condition",
      "description": "Sensitivity-driven exclusion: EFFECTIVELY EXCLUDED | UNLIKELY | CANNOT EXCLUDE",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "rule_in_condition",
      "name": "Rule In Condition",
      "description": "Likelihood-ratio driven: HIGHLY SUPPORTIVE | SUPPORTIVE | CONSISTENT",
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    }
  ],
  "models": [],
  "knowledge": [],
  "permissions": [
    {
      "role": "DOCTOR",
      "claims": [
        "ai:clinical_reasoning"
      ]
    }
  ],
  "ui": {
    "routes": [],
    "components": [
      {
        "name": "ClinicalReasoningPanel",
        "slot": "clinical-workspace"
      }
    ],
    "icons": [
      "brain-circuit",
      "stethoscope"
    ]
  },
  "database": {
    "migrations": [],
    "seeds": []
  },
  "events": {
    "publishes": [
      "clinical.reasoning.complete",
      "clinical.blindspot.found"
    ],
    "subscribes": [
      "lab.critical.alert"
    ]
  },
  "healthChecks": [
    {
      "name": "Reasoning Model",
      "endpoint": "model-router",
      "timeoutMs": 5000,
      "critical": true
    },
    {
      "name": "RAG Retrieval",
      "endpoint": "knowledge-registry",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "Knowledge Graph",
      "endpoint": "knowledge-registry",
      "timeoutMs": 3000,
      "critical": true
    }
  ],
  "configurationSchema": {
    "properties": {
      "reasoningDepth": {
        "type": "string",
        "default": "CONSULTANT"
      }
    },
    "secrets": []
  },
  "riskLevel": "HIGH",
  "checksum": "sha256:clinical-reasoning-plugin-1.0.0"

{
  "pluginId": "clinical-reasoning-plugin",
  "tier": "P3",
  "category": "MEDICAL",
  "name": "Clinical Reasoning Plugin",
  "version": "1.0.0",
  "description": "Differential diagnosis, pathophysiology, blind spot detection, disease trajectory, sparse-data reasoning.",
  "license": "MIT",
  "provider": "ASTRA",
  "runtime": "nodejs",
  "dependencies": {
    "required": [
      "astra-brain-core",
      "langgraph-orchestrator",
      "medical-knowledge-gateway",
      "medical-model-pack"
    ],
    "optional": [
      "daily-learning-evaluation"
    ]
  },
  "services": [

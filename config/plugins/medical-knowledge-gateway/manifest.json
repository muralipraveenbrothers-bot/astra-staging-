{
  "pluginId": "medical-knowledge-gateway",
  "tier": "P0",
  "category": "KNOWLEDGE",
  "name": "Medical Knowledge Gateway",
  "version": "1.0.0",
  "description": "Smart RAG pipeline: hybrid dense+BM25 retrieval, vector store, reranker, ingestion, citation validation, conflict detection.",
  "license": "MIT",
  "provider": "ASTRA",
  "runtime": "nodejs",
  "dependencies": {
    "required": [
      "astra-brain-core"
    ],
    "optional": []
  },
  "services": [
    {
      "serviceId": "rag-pipeline",
      "type": "knowledge",
      "endpoint": "/api/knowledge",
      "healthEndpoint": "/api/knowledge/stats"
    }
  ],
  "agents": [
    {
      "agentId": "knowledge_ingestor",
      "name": "Knowledge Ingestor",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "hermes_brain"
    },
    {
      "agentId": "citation_validator",
      "name": "Citation Validator",
      "level": "MANAGER",
      "autoRegister": true,
      "parentAgent": "hermes_brain"
    },
    {
      "agentId": "freshness_scanner",
      "name": "Freshness Scanner",
      "level": "WORKER",
      "autoRegister": true,
      "parentAgent": "knowledge_ingestor"
    }
  ],
  "tools": [
    {
      "toolId": "ingest_source",
      "name": "Ingest Source",
      "description": "Ingest a knowledge source",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "WRITE"
    },
    {
      "toolId": "search_knowledge",
      "name": "Search Knowledge",
      "description": "Hybrid RAG search",
      "inputSchema": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "limit": {
            "type": "number"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "verify_citation",
      "name": "Verify Citation",
      "description": "Validate citation against source",
      "inputSchema": {
        "type": "object",
        "properties": {
          "citation": {
            "type": "object"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    },
    {
      "toolId": "check_freshness",
      "name": "Check Freshness",
      "description": "Check source freshness",
      "inputSchema": {
        "type": "object",
        "properties": {
          "sourceId": {
            "type": "string"
          }
        }
      },
      "outputSchema": {
        "type": "object"
      },
      "riskLevel": "INFO",
      "readOrWrite": "READ"
    }
  ],
  "models": [
    {
      "modelRouteId": "embeddings_minilm",
      "provider": "local",
      "modelType": "EMBEDDING"
    },
    {
      "modelRouteId": "medical_reranker",
      "provider": "local",
      "modelType": "RERANKER"
    }
  ],
  "knowledge": [
    {
      "sourceId": "pubmed",
      "type": "external",
      "accessScope": "public",
      "autoIndex": true
    },
    {
      "sourceId": "europe_pmc",
      "type": "external",
      "accessScope": "public",
      "autoIndex": true
    },
    {
      "sourceId": "clinicaltrials",
      "type": "external",
      "accessScope": "public",
      "autoIndex": true
    },
    {
      "sourceId": "who_iris",
      "type": "external",
      "accessScope": "public",
      "autoIndex": true
    }
  ],
  "permissions": [
    {
      "role": "DOCTOR",
      "claims": [
        "ai:evidence_search"
      ]
    },
    {
      "role": "ADMIN",
      "claims": [
        "knowledge:configure"
      ]
    }
  ],
  "ui": {
    "routes": [
      {
        "path": "/knowledge",
        "component": "KnowledgeFabric",
        "roles": [
          "DOCTOR",
          "ADMIN"
        ]
      }
    ],
    "components": [
      {
        "name": "EvidenceAiCopilot",
        "slot": "evidence-panel"
      }
    ],
    "icons": [
      "book-open",
      "globe"
    ]
  },
  "database": {
    "migrations": [],
    "seeds": []
  },
  "events": {
    "publishes": [
      "knowledge.indexed",
      "knowledge.conflict.detected"
    ],
    "subscribes": [
      "data.updated"
    ]
  },
  "healthChecks": [
    {
      "name": "Vector Store",
      "endpoint": "knowledge-registry",
      "timeoutMs": 3000,
      "critical": true
    },
    {
      "name": "Embedding Model",
      "endpoint": "ollama-local",
      "timeoutMs": 5000,
      "critical": true
    },
    {
      "name": "BM25 Index",
      "endpoint": "knowledge-registry",
      "timeoutMs": 3000,
      "critical": false
    },
    {
      "name": "PubMed Connector",
      "endpoint": "external-pubmed",
      "timeoutMs": 6000,
      "critical": false
    }
  ],
  "configurationSchema": {
    "properties": {
      "embeddingModel": {
        "type": "string",
        "default": "bge-m3"
      },
      "indexChunkSize": {
        "type": "number",
        "default": 512
      }
    },
    "secrets": [
      "PINECONE_KEY",
      "QDRANT_KEY",
      "OPENAI_EMBEDDING_KEY"
    ]
  },
  "riskLevel": "HIGH",
  "checksum": "sha256:medical-knowledge-gateway-1.0.0",
  "knowledgeMetrics": {

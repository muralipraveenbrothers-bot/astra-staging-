# ──────────────────────────────────────────────────────────────────────
#  ASTRA AI — LLM Gateway wiring (Hermes + Paperclip → OmniRoute → FreeLLMAPI)
#  Copy to .env.local (or merge into your backend env) and fill in.
# ──────────────────────────────────────────────────────────────────────

# Native Astra stack: OmniRoute is a single Next.js process on :5171
# (dashboard HTML + OpenAI-compatible /v1). Docker compose defaults are 20128/20129.
ASTRA_LLM_GATEWAY_BASE_URL=http://127.0.0.1:5171/v1
ASTRA_LLM_GATEWAY_API_KEY=           # an OmniRoute client/API key

# Model to request through the gateway (must exist in OmniRoute's catalog)
ASTRA_LLM_GATEWAY_MODEL=             # e.g. freellm/<model-id> — check the dashboard

# Upstream proxy: FreeLLMAPI (aggregates free-tier provider keys behind one
# unified key). Registered INSIDE OmniRoute as a custom OpenAI-compatible
# provider — Astra normally never talks to it directly. Kept here only for
# tools that need a direct, key-per-provider-free endpoint.
ASTRA_FREELLMAPI_BASE_URL=http://127.0.0.1:31415/v1
ASTRA_FREELLMAPI_API_KEY=            # FreeLLMAPI unified key (Dashboard → API Keys)

# Voice tier keys (see existing sections above)
# VITE_OPENAI_API_KEY=sk-...

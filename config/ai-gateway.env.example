# ASTRA AI — backend-only model gateway (never VITE_* — never sent to the browser)
# Copy to config/ai-gateway.env or merge into .env.local

# PRIMARY — FreeLLMAPI OpenAI-compatible API. ONE process on the gateway port
# (31416) serves BOTH the REST API and the dashboard; the old two-process layout
# (an Express API port plus a separate Vite dashboard port) is RETIRED, and both
# retired ports are firewalled by
# server/astra/supervisor/stack-contract.spec.ts. Never retype these — copy
# config/ai-gateway.env (the source of truth) or run scripts/sync-stack-config.mjs.
FREELLMAPI_BASE_URL=http://127.0.0.1:31416/v1
FREELLMAPI_API_KEY=
FREELLMAPI_MODEL=auto
FREELLMAPI_TIMEOUT_MS=60000
# Same host:port as the API — there is no separate dashboard port any more.
FREELLMAPI_DASHBOARD_URL=http://127.0.0.1:31416/

# Development-only local account bootstrap used by scripts/start-all.ps1.
# Provide your own numeric PINs (six digits or more). These values are never logged.
ASTRA_SEED_RECEPTION_PIN=
ASTRA_SEED_DOCTOR_PIN=
ASTRA_SEED_CEO_PIN=

# Gemini (server-side only — never VITE_*). Optional. If unset, Gemini is skipped.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GEMINI_TIMEOUT_MS=30000

# FALLBACK — OmniRoute OpenAI-compatible API
# Native Astra stack: single Next.js process on :5171 (dashboard + /v1).
# Upstream Docker compose defaults remain 20128 (dashboard) / 20129 (API).
OMNIROUTE_BASE_URL=http://127.0.0.1:5171/v1
OMNIROUTE_API_KEY=
OMNIROUTE_DASHBOARD_URL=http://127.0.0.1:5171/home

# Central AI Adapter (what Hermes / OpenClaw / Paperclip / n8n must call)
ASTRA_ADAPTER_BASE_URL=http://127.0.0.1:3000/v1
ASTRA_ADAPTER_API_KEY=                 # defaults to FREELLMAPI_API_KEY if empty

# LOCAL FALLBACK — Ollama (not a separate brain)
OLLAMA_BASE_URL=http://127.0.0.1:11434/v1

# Orchestration / workflow (not model routers). They call ASTRA_ADAPTER_BASE_URL.

# ────────────────────────────────────────────────────────────────────────────
# PHASE 2 — OPTIONAL LIVE AVATAR / VOICE INTEGRATIONS
# ────────────────────────────────────────────────────────────────────────────
# Linly-Talker (Kedreamix) — optional GPU voice/avatar service (see integrations/linly-talker).
#   API contract verified from pinned api/: POST /tts_response/ (multipart),
#   POST /talker_response/, POST /tts_change_model/. No /health or /asr upstream —
#   Astra reports that honestly instead of inventing endpoints.
LINLY_ENABLED=false
LINLY_BASE_URL=

# Live Avatar Agent (wukath/live-avatar-agent-demo) — optional ADK/Gemini-Live
# presentation service. Astra remains the clinical brain; this is presentation-only.
LIVE_AVATAR_ENABLED=false
LIVE_AVATAR_BASE_URL=
LIVE_AVATAR_APP_NAME=live_avatar_agent
LIVE_AVATAR_USER=web_avatar_user

# Timeouts (Phase 2 §27) — sane defaults; override per deployment.
ASTRA_AI_TIMEOUT_MS=60000
ASTRA_STT_TIMEOUT_MS=60000
ASTRA_TTS_TIMEOUT_MS=60000
ASTRA_AVATAR_TIMEOUT_MS=8000

# Circuit breaker (Phase 2 §26)
ASTRA_BREAKER_THRESHOLD=3
ASTRA_BREAKER_COOLDOWN_MS=30000

# Privacy (Phase 2 §20): Astra never persists mic audio or transcripts by default.
# These are explicit opt-in; leave false unless a deployment requires retention.
ASTRA_AUDIO_RETENTION=false
ASTRA_TRANSCRIPT_RETENTION=false

# Security (Phase 2 §21): production always 401s unauthenticated requests.
# The legacy dev fallback (unauthenticated → doctor) is ONLY available in
# non-production AND when explicitly enabled here. Never set this in production.
ASTRA_DEV_AUTH_BYPASS=false

# ────────────────────────────────────────────────────────────────────────────
# AVATAR / DIGITAL HUMAN (all optional — Astra runs fully without them, and
# every one of these reports OFFLINE honestly when unreachable).
# ────────────────────────────────────────────────────────────────────────────
# Local Astra Audio2Face-3D broadcast controller (Python, server/avatar/)
A2F_CONTROLLER_URL=http://127.0.0.1:8283
A2F_CONTROLLER_PORT=8283

# NVIDIA Audio2Face Omniverse extension JSON-RPC endpoint (real push channel:
# audio2face.PushAudioTrack). Set A2F_GRPC_TARGET for native gRPC stubs instead.
A2F_OMNIVERSE_JSONRPC=http://localhost:8011/jsonrpc
A2F_GRPC_TARGET=localhost:50051
A2F_PLAYER_NODE=/Audio2Face/Player

# OpenAvatarChat / LiteAvatar live avatar UI
OPENAVATAR_URL=http://127.0.0.1:8282

# Voicebox TTS + Whisper STT runtime (en / hi / te)
VOICEBOX_URL=http://127.0.0.1:17493

# Central broadcast engine + controller ports
BROADCAST_ENGINE_PORT=8000
BROADCAST_CONTROLLER_PORT=8285
BROADCAST_SVC_URL=http://127.0.0.1:8285/api/broadcast

# Full-duplex voice core (STT → brain → TTS → A2F)
ASTRA_VOICE_PORT=9000
ASTRA_BRAIN_URL=http://127.0.0.1:3000/api/chat

# ────────────────────────────────────────────────────────────────────────────
# PLATFORM PROBES — used by server/platform/pillars.ts for honest health
# reporting. Override only when a service is relocated.
# ────────────────────────────────────────────────────────────────────────────
OLLAMA_BASE_URL=http://127.0.0.1:11434/api/tags
AGENTZERO_URL=http://127.0.0.1:5000/api/health
OPENHANDS_URL=http://127.0.0.1:18000/server_info
HERMES_BASE_URL=http://127.0.0.1:9119
HERMES_API_KEY=
PAPERCLIP_BASE_URL=http://127.0.0.1:3100
PAPERCLIP_API_KEY=
N8N_BASE_URL=http://127.0.0.1:5678
N8N_API_KEY=
OPENCLAW_BASE_URL=http://127.0.0.1:18789
OPENCLAW_API_KEY=

# Manus is a cloud worker — do NOT point it at FreeLLMAPI.
MANUS_BASE_URL=https://api.manus.ai/v2
MANUS_API_KEY=

# Optional relocated Hermes runtime (leave unset to use packaged/default install)
# ASTRA_HERMES_CLI_PATH=C:\\h\\hermes-agent\\hermes
# ASTRA_HERMES_HOME=C:\\h\\hermes-home

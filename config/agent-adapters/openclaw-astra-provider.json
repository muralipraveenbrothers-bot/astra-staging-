{
  "models": {
    "mode": "merge",
    "providers": {
      "astra": {
        "api": "openai-completions",
        "baseUrl": "http://127.0.0.1:3000/v1",
        "apiKey": "${ASTRA_ADAPTER_API_KEY}",
        "models": [
          {
            "id": "auto",
            "name": "Astra Central Adapter (freellmapi)",
            "reasoning": false,
            "input": [
              "text"
            ],
            "cost": {
              "input": 0,
              "output": 0,
              "cacheRead": 0,
              "cacheWrite": 0
            },
            "contextWindow": 1048576,
            "maxTokens": 8192
          }
        ]
      }
    }
  },
  "agents": {
    "defaults": {
      "model": {
        "primary": "astra/auto"
      }
    }
  }
}

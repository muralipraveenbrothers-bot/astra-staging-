{
  "name": "astra-hospital-ops",
  "private": true,
  "version": "1.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "dev:https": "vite --mode https",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "test": "vitest run && vitest run --config vitest.browser.config.ts",
    "test:watch": "vitest",
    "stack:preflight": "node scripts/stack-preflight.mjs",
    "stack:verify": "node scripts/verify-stack.mjs",
    "stack:contract": "vitest run server/astra/supervisor",
    "stack:deploy": "node scripts/deploy-candidate.mjs",
    "stack:watchdog": "tsx scripts/stack-watchdog.mjs",
    "lint": "tsc -b && tsc --noEmit -p tsconfig.server.json",
    "typecheck:server": "tsc --noEmit -p tsconfig.server.json",
    "typecheck:server:full": "tsc --noEmit -p tsconfig.astra-check.json",
    "astra:saarathi": "powershell -NoProfile -ExecutionPolicy Bypass -File scripts/start-astra-saarathi.ps1",
    "astra": "powershell -ExecutionPolicy Bypass -File scripts/verify-astra.ps1"
  },
  "dependencies": {
    "@langchain/core": "^1.2.9",
    "@langchain/langgraph": "^1.4.13",
    "@mediapipe/tasks-vision": "^0.10.35",
    "@modelcontextprotocol/sdk": "^1.30.0",
    "@react-three/drei": "^9.122.0",
    "@react-three/fiber": "^8.18.0",
    "@react-three/postprocessing": "^2.16.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "framer-motion": "^11.11.9",
    "http-proxy-middleware": "^3.0.7",
    "lucide-react": "^0.454.0",
    "postprocessing": "^6.36.6",
    "qrcode": "^1.5.4",
    "qrcode.react": "^4.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "recharts": "^2.13.3",
    "sonner": "^1.5.0",
    "tailwind-merge": "^2.5.4",
    "three": "^0.160.1",
    "ws": "^8.21.3"
  },
  "devDependencies": {
    "@gltf-transform/cli": "^4.5.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^20.16.11",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^18.3.11",
    "@types/react-dom": "^18.3.1",
    "@types/ws": "^8.18.1",
    "@vitejs/plugin-basic-ssl": "^1.2.0",
    "@vitejs/plugin-react": "^4.3.2",
    "autoprefixer": "^10.4.20",
    "playwright-core": "^1.62.1",
    "postcss": "^8.4.47",
    "tailwindcss": "^3.4.14",
    "ts-node": "^10.9.2",
    "tsx": "^4.23.14",
    "typescript": "~5.6.3",
    "vite": "^5.4.9",
    "vitest": "^4.1.11"
  }
}
